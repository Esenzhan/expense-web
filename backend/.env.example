# Postgres (e.g. Neon connection string)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Anthropic API key (Claude Haiku is used for parsing spoken expenses)
ANTHROPIC_API_KEY=sk-ant-xxxx

# Deepgram API key (streaming speech-to-text, supports Russian: language=ru)
DEEPGRAM_API_KEY=xxxx

# Origin of the deployed frontend, for CORS AND for the post-login redirect
FRONTEND_URL=https://your-frontend.vercel.app

PORT=3001

# --- Google OAuth login (Sign in with Google) ---
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=xxxx
GOOGLE_OAUTH_REDIRECT_URI=https://your-backend.onrender.com/api/auth/google/callback

# Comma-separated allowlist — only these Google accounts may log in
ALLOWED_EMAILS=you@gmail.com,partner@gmail.com

# Random long string, signs the session JWT
JWT_SECRET=xxxx

# Random long string, encrypts stored Google refresh tokens at rest
TOKEN_ENCRYPTION_KEY=xxxx

# Which account's personal Sheet the "Ремонт" wallet always mirrors into
# (matches the bot's old RENOVATION_SHEET_ID behavior) — must be one of the
# ALLOWED_EMAILS
RENOVATION_OWNER_EMAIL=you@gmail.com
