# Telegram bot token (@BotFather)
TELEGRAM_TOKEN=xxxx

# Claude Haiku parses spoken/typed/photographed expenses
ANTHROPIC_API_KEY=sk-ant-xxxx

# Whisper transcribes voice messages
OPENAI_API_KEY=sk-xxxx

# The two allowed household members
USER1_TELEGRAM_ID=xxxx
USER1_SHEET_ID=xxxx
USER2_TELEGRAM_ID=xxxx
USER2_SHEET_ID=xxxx

# Service account with access to both personal Sheets — only used for
# /budget and /renovation, which still read Sheets directly
GOOGLE_CREDENTIALS_FILE=credentials.json

# The website backend — bot posts expenses and reads categories through it
API_BASE_URL=https://expense-web-peo6.onrender.com

# Per-account keys from the `users.bot_api_key` column (Postgres) — identify
# which account a Telegram message should be posted as
USER1_BOT_KEY=xxxx
USER2_BOT_KEY=xxxx
